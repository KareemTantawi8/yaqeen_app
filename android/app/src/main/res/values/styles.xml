<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native window is invisible so only the Flutter splash is visible (no green / drawable flash). -->
    <style name="TransparentLaunchTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <!-- Theme applied after Flutter draws; window background behind the Flutter UI -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
